          {
            "name": "FactSales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataRoot & \"FactSales.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    EmptyToNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(EmptyToNull, {{\"SourceRow\", Int64.Type}, {\"InvoiceKey\", type text}, {\"ProductKey\", type text}, {\"CustomerKey\", type text}, {\"CountryKey\", type text}, {\"DateKey\", Int64.Type}, {\"Quantity\", Int64.Type}, {\"UnitPrice\", type number}, {\"LineAmountPence\", Int64.Type}, {\"GrossSalesGBP\", type number}, {\"ReturnsGBP\", type number}, {\"NetSalesGBP\", type number}, {\"IsSale\", Int64.Type}, {\"IsReturn\", Int64.Type}, {\"CancellationFlag\", Int64.Type}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Net Invoice Value",
            "expression": "SUM(FactSales[LineAmountPence]) / 100",
            "formatString": "£#,0.00;(£#,0.00)",
            "displayFolder": "Performance",
            "description": "Net Invoice Value. Format: £#,0.00;(£#,0.00). Definition: SUM(FactSales[LineAmountPence]) / 100. See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "ceb55081-1752-53f6-99be-c0750214e327"
          },
          {
            "name": "Gross Sales",
            "expression": "SUM(FactSales[GrossSalesGBP])",
            "formatString": "£#,0.00;(£#,0.00)",
            "displayFolder": "Performance",
            "description": "Gross Sales. Format: £#,0.00;(£#,0.00). Definition: SUM(FactSales[GrossSalesGBP]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "8983e07a-d65f-560b-adbe-7d977ff3842c"
          },
          {
            "name": "Returns Value",
            "expression": "SUM(FactSales[ReturnsGBP])",
            "formatString": "£#,0.00;(£#,0.00)",
            "displayFolder": "Performance",
            "description": "Returns Value. Format: £#,0.00;(£#,0.00). Definition: SUM(FactSales[ReturnsGBP]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "f38df204-f59d-5052-95c3-31503b9bd9e0"
          },
          {
            "name": "Return Value Rate",
            "expression": "DIVIDE([Returns Value], [Gross Sales])",
            "formatString": "0.0%",
            "displayFolder": "Performance",
            "description": "Return Value Rate. Format: 0.0%. Definition: DIVIDE([Returns Value], [Gross Sales]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "20375803-680f-5722-8d1f-99403b9ed5d3"
          },
          {
            "name": "Sales Invoices",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSales[InvoiceKey]), FactSales[IsSale] = 1)",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Sales Invoices. Format: #,0. Definition: CALCULATE(DISTINCTCOUNT(FactSales[InvoiceKey]), FactSales[IsSale] = 1). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "40454d6a-a65c-55fa-9e8b-559454e86500"
          },
          {
            "name": "Average Sales Invoice",
            "expression": "DIVIDE([Gross Sales], [Sales Invoices])",
            "formatString": "£#,0.00",
            "displayFolder": "Performance",
            "description": "Average Sales Invoice. Format: £#,0.00. Definition: DIVIDE([Gross Sales], [Sales Invoices]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "44dd74a3-f7c0-5570-bb55-4a9f277e6c90"
          },
          {
            "name": "Identified Buyers",
            "expression": "CALCULATE(DISTINCTCOUNT(FactSales[CustomerKey]), FactSales[IsSale] = 1, FactSales[CustomerKey] <> \"Unknown\")",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Identified Buyers. Format: #,0. Definition: CALCULATE(DISTINCTCOUNT(FactSales[CustomerKey]), FactSales[IsSale] = 1, FactSales[CustomerKey] <> \"Unknown\"). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "10ac4a93-1775-50fc-a464-352bfe2d8ad9"
          },
          {
            "name": "Net Units",
            "expression": "SUM(FactSales[Quantity])",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Net Units. Format: #,0. Definition: SUM(FactSales[Quantity]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "fc0f2f01-d2d1-585a-a5f3-2aaa38a53ee3"
          },
          {
            "name": "Unknown Customer Value",
            "expression": "CALCULATE([Net Invoice Value], FactSales[CustomerKey] = \"Unknown\")",
            "formatString": "£#,0.00",
            "displayFolder": "Quality and coverage",
            "description": "Unknown Customer Value. Format: £#,0.00. Definition: CALCULATE([Net Invoice Value], FactSales[CustomerKey] = \"Unknown\"). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "7a4a95f4-44a6-50bd-87c6-961969defce3"
          },
          {
            "name": "Unknown Customer Share",
            "expression": "DIVIDE([Unknown Customer Value], [Net Invoice Value])",
            "formatString": "0.0%",
            "displayFolder": "Quality and coverage",
            "description": "Unknown Customer Share. Format: 0.0%. Definition: DIVIDE([Unknown Customer Value], [Net Invoice Value]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "967f554f-3a36-5882-a38f-ee974d7fe994"
          },
          {
            "name": "International Invoice Value",
            "expression": "CALCULATE([Net Invoice Value], KEEPFILTERS(DimCountry[Market] = \"International\"))",
            "formatString": "£#,0.00",
            "displayFolder": "Performance",
            "description": "International Invoice Value. Format: £#,0.00. Definition: CALCULATE([Net Invoice Value], KEEPFILTERS(DimCountry[Market] = \"International\")). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "58f7e382-69b3-5653-a581-68098fa8caa7"
          },
          {
            "name": "Repeat Buyer Rate",
            "expression": "VAR Buyers = FILTER(VALUES(FactSales[CustomerKey]), FactSales[CustomerKey] <> \"Unknown\" && CALCULATE([Sales Invoices]) > 0) VAR RepeatBuyers = FILTER(Buyers, CALCULATE([Sales Invoices]) > 1) RETURN DIVIDE(COUNTROWS(RepeatBuyers), COUNTROWS(Buyers))",
            "formatString": "0.0%",
            "displayFolder": "Performance",
            "description": "Repeat Buyer Rate. Format: 0.0%. Definition: VAR Buyers = FILTER(VALUES(FactSales[CustomerKey]), FactSales[CustomerKey] <> \"Unknown\" && CALCULATE([Sales Invoices]) > 0) VAR RepeatBuyers = FILTER(Buyers, CALCULATE([Sales Invoices]) > 1) RETURN DIVIDE(COUNTROWS(RepeatBuyers), COUNTROWS(Buyers)). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "400bd56b-f8f8-59f6-8030-af7a80f341ca"
          },
          {
            "name": "Invoice Lines",
            "expression": "COUNTROWS(FactSales)",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Invoice Lines. Format: #,0. Definition: COUNTROWS(FactSales). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "08e7ac2e-4600-5d03-8bb6-572f6ea3213f"
          },
          {
            "name": "Latest Complete Month Value",
            "expression": "VAR LastMonth = CALCULATE(MAX(DimDate[YearMonthSort]), REMOVEFILTERS(DimDate), DimDate[IsCompleteMonth] = 1) RETURN CALCULATE([Net Invoice Value], REMOVEFILTERS(DimDate), DimDate[YearMonthSort] = LastMonth)",
            "formatString": "£#,0.00",
            "displayFolder": "Performance",
            "description": "Latest Complete Month Value. Format: £#,0.00. Definition: VAR LastMonth = CALCULATE(MAX(DimDate[YearMonthSort]), REMOVEFILTERS(DimDate), DimDate[IsCompleteMonth] = 1) RETURN CALCULATE([Net Invoice Value], REMOVEFILTERS(DimDate), DimDate[YearMonthSort] = LastMonth). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "98353271-3e2e-592a-98aa-4136b17e86e4"
          }
        ]
      }
    ],
